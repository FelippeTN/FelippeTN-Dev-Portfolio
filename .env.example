VITE_SITE_URL=https://seudominio.com

# Supabase — copie este arquivo para .env e preencha com os dados do seu projeto.
# Encontre em: Supabase > Project Settings > Data API / API Keys

# URL do projeto (ex.: https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Chave pública "anon" (pode ir pro frontend; a segurança real vem das policies/RLS)
VITE_SUPABASE_ANON_KEY=

# E-mail autorizado a acessar o painel /admin (o seu e-mail de login no Supabase)
VITE_ADMIN_EMAIL=
